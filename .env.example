# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:your_db_password_here@db:5432/postgres

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_MINUTES=10

# CORS
ALLOWED_ORIGINS=["*"]

# Mail (SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# OpenAI
OPENAI_API_KEY=sk-...

# Razorpay — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Sentry — get DSN from https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=https://788b85457e7dcaa5e6f131f7de3a0c74@o4511423299780608.ingest.us.sentry.io/4511423328223232
# Frontend
FRONTEND_URL=https://your-frontend-url.com
